# Copy to .env and fill in real secrets. .env is gitignored — never commit it.
# Generate SESSION_SECRET: python -c 'import secrets; print(secrets.token_hex(32))'

# --- Application ---
APP_NAME=VPSHub
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_USERNAME=manager
ADMIN_PASSWORD=REPLACE_WITH_PASSWORD_AT_LEAST_12_CHARS
# true only when the panel is served over HTTPS (behind a TLS proxy)
COOKIE_SECURE=false
SEED_DEMO=true

# --- PostgreSQL (consumed by the `db` service) ---
POSTGRES_DB=vpshub
POSTGRES_USER=vpshub
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# DATABASE_URL is consumed by the app. In Compose the DB host is the service
# name `db`, NOT localhost. Keep user/password/db in sync with POSTGRES_* above.
# Percent-encode any special characters in the password.
DATABASE_URL=postgresql+psycopg://vpshub:REPLACE_WITH_DB_PASSWORD@db:5432/vpshub

# Local SQLite instead of Postgres (e.g. running the app without Compose):
# DATABASE_URL=sqlite:///./data/vpshub.db
